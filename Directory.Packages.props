    <PackageVersion Include="EvilBaschdi.Core.Avalonia" Version="2026.10.9.14" />
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageVersion Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
  </ItemGroup>
