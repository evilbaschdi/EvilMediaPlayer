    <PackageVersion Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
